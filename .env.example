# ---- APKookies environment template ----
# Copy to .env and fill in. Never commit real secrets.

# --- API ---
APK_ENV=dev
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# --- Storage / ephemeral policy ---
# Only hashes/IOCs/feature vectors are persisted; raw samples are wiped post-analysis.
EPHEMERAL_SAMPLE_TTL_SECONDS=3600
ARTIFACT_STORE_PATH=./.artifacts
# Remembered verdicts + analyst audit log (SQLite; hashes and verdicts only).
VERDICT_DB_PATH=./.artifacts/verdicts.sqlite3
# Enables /v1/verdicts override/clear (sent as X-Analyst-Token). Leave empty to disable.
# Use a long random value; stop-gap until per-user API authentication exists.
ANALYST_TOKEN=

# --- Knowledge graph (Neo4j) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME

# --- GenAI (RAG-grounded reporting) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
GEMINI_AGENT=antigravity-preview-05-2026
GEMINI_ENVIRONMENT=remote
VECTOR_STORE_PATH=./.chroma

# --- Threat intel feeds ---
THREATFOX_API_KEY=CHANGE_ME

# --- Sandbox ---
# Path to headless AVD / VirtualBox VM used for disposable runs.
SANDBOX_AVD_NAME=apkookies_clean
SANDBOX_SNAPSHOT=clean_state
MITM_PROXY_PORT=8080
# adb binary; leave empty to auto-detect (ANDROID_HOME, default SDK folder, PATH)
ADB_PATH=
# Emulator/device serial, e.g. emulator-5554 or 192.168.56.101:5555; empty = first online device
ANDROID_SERIAL=

# --- Optional Quark-Engine rules (pip install -e ".[quark]"; see docs/QUARK.md) ---
QUARK_RULES_DIR=
QUARK_MIN_CONFIDENCE=80

# --- WhatsApp bot (clients/whatsapp_bot/main.py; run with uvicorn --env-file .env) ---
# Run the bot on an isolated machine: anyone with the number can send it a real APK.
OPENWA_URL=http://localhost:2785
OPENWA_API_KEY_FILE=openwa/.api-key
# APKookies backend (uvicorn backend.api.main:app); the bot calls /v1/submit/apk
APKOOKIES_API_URL=http://localhost:8000
# Raw webhook payloads contain senders' phone numbers: keep false unless debugging
BOT_LOG_WEBHOOKS=false
BOT_LOG_DIR=webhook_logs
BOT_SANDBOX_POLL_SECONDS=20
BOT_SANDBOX_TIMEOUT_SECONDS=1800
BOT_ANALYSIS_TIMEOUT_SECONDS=900

# --- Touchpoints ---
TELEGRAM_GETME_ENDPOINT=https://api.telegram.org/bot{token}/getMe
PLAY_INTEGRITY_PROJECT_NUMBER=CHANGE_ME
